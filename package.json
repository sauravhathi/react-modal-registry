{
  "name": "react-modal-registry",
  "version": "0.1.2",
  "description": "Type-safe modal registry and promise-based dialog manager for React",
  "keywords": [
    "react-modal",
    "modal-manager",
    "promise-modal",
    "async-modal",
    "imperative-modal",
    "dialog-manager",
    "modal-registry",
    "use-modal",
    "confirmation-dialog",
    "confirmation-modal",
    "alert-dialog",
    "nice-modal",
    "type-safe-modal",
    "url-modal",
    "deep-link",
    "overlay-manager",
    "react-dialog",
    "react",
    "typescript"
  ],
  "author": "Saurav Hathi <https://github.com/sauravhathi>",
  "homepage": "https://github.com/sauravhathi/react-modal-registry#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sauravhathi/react-modal-registry.git"
  },
  "bugs": {
    "url": "https://github.com/sauravhathi/react-modal-registry/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.14.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^5.0.3"
  }
}
